{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sgcm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Scheduling": {
    "TimeZone": "America/Santo_Domingo",
    "AppointmentDurationHours": 2,
    "MinimumBlockDurationHours": 6,
    "MinimumBookingLeadDays": 4,
    "BookingHorizonDays": 90,
    "ConfirmationDeadlineHours": 48,
    "PatientCancellationDeadlineHours": 24,
    "PatientRescheduleDeadlineHours": 48,
    "DoctorLateCancellationThresholdHours": 6,
    "DoctorLateCancellationMinimumWords": 30,
    "PatientReminderLeadHours": 24
  },
  "Jwt": {
    "Issuer": "SGCM",
    "Audience": "SGCM",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaxActiveSessionsPerUser": 5,
    "ClockSkewSeconds": 30
  },
  "Accounts": {
    "EmailConfirmationTokenMinutes": 15,
    "ResendConfirmationCooldownSeconds": 30,
    "PasswordResetTokenMinutes": 10
  },
  "LoginLimits": {
    "MaxFailedAttemptsPerEmail": 5,
    "EmailWindowMinutes": 15,
    "MaxRequestsPerIp": 20,
    "IpWindowSeconds": 60
  },
  "Worker": {
    "Enabled": true,
    "Intervals": {
      "GenerateAvailabilityBlocks": "1.00:00:00",
      "ExpirePendingAppointments": "00:05:00",
      "CompleteFinishedAppointments": "00:05:00",
      "SendDueReminders": "00:01:00",
      "PurgeUnconfirmedAccounts": "00:05:00",
      "PurgeExpiredCredentials": "1.00:00:00"
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
